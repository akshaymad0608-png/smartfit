# ─────────────────────────────────────────────────────────────
# Google Sign-In (Google Identity Services) — browser
# ─────────────────────────────────────────────────────────────
# console.cloud.google.com/apis/credentials → OAuth client (Web application)
# Authorized JavaScript origins: https://fitsmart.space , http://localhost:5173
# A default Client ID is already baked into the code, so this is optional.
VITE_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
# Welcome email on login — EmailJS (client-side, no backend)
# ─────────────────────────────────────────────────────────────
# 1. Create a free account at https://www.emailjs.com
# 2. Email Services → add a service (e.g. connect your Gmail) → copy the Service ID
# 3. Email Templates → create a template. Set its "To Email" field to {{to_email}}
#    and use {{to_name}} in the body. Copy the Template ID.
# 4. Account → General → copy your Public Key.
# 5. Set these in your host's env vars (Vercel) or the AI Studio env prompt.
# These are PUBLIC values (safe in the browser) — EmailJS restricts abuse by
# allowed domains configured in your EmailJS account settings.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
