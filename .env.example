# ─────────────────────────────────────────────────────────────
# Google Sign-In (Google Identity Services) — browser
# ─────────────────────────────────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID → type "Web application"
# 3. Authorized JavaScript origins: https://fitsmart.space , http://localhost:5173
# 4. Paste the Client ID here (looks like 1234-abc.apps.googleusercontent.com)
# A default Client ID is already baked into the code, so this is optional.
VITE_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
# Welcome email on login — server-side (Vercel function /api/welcome)
# ─────────────────────────────────────────────────────────────
# 1. Create a free account at https://resend.com and make an API key.
# 2. Add it in Vercel → Project → Settings → Environment Variables (NOT here in the repo).
# 3. To email ANY user, verify your domain in Resend and set WELCOME_FROM_EMAIL
#    to an address on that domain, e.g. "SmartFit <hello@fitsmart.space>".
#    (Without a verified domain, Resend only delivers to your own signup email.)
RESEND_API_KEY=
WELCOME_FROM_EMAIL=SmartFit <onboarding@resend.dev>
